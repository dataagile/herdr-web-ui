{
 "version": 1,
 "descricao": "Fixtures do scrub por valor (DAI-165). Contrato compartilhado front (TS) e back (Python): mesma tabela, dois testes. Regra nova = caso novo no mesmo PR.",
 "placeholders": {
  "TOKEN": "segredo/token/credencial",
  "Q": "valor de query string",
  "DOC": "CPF/CNPJ",
  "NUM": "sequência ≥13 dígitos",
  "EMAIL": "e-mail",
  "TEXTO OMITIDO n chars": "texto de chat"
 },
 "kinds": {
  "text": "scrub de texto livre (console, message)",
  "url": "scrub de path+query",
  "chat_text": "texto que veio do chat",
  "key": "nome de chave sensível? expected=bool"
 },
